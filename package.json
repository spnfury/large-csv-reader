{
  "name": "large-csv-reader",
  "version": "0.1.0",
  "description": "Open, page through, search, slice and split multi-gigabyte CSV files in the browser or Node without loading them into memory.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/"
  },
  "engines": {
