  "author": "CSV Creator (https://csvcreator.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spnfury/large-csv-reader.git"
  },
  "bugs": {
    "url": "https://github.com/spnfury/large-csv-reader/issues"
  }
}
