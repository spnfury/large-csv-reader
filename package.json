  },
  "keywords": [
    "csv",
    "large-csv",
    "big-csv",
    "csv-viewer",
    "csv-parser",
    "split-csv",
    "excel",
    "browser",
    "file-api",
    "streaming"
  ],
  "homepage": "https://csvcreator.com/en/large-csv-viewer",
